---
// Navegação local fixa das páginas de solução, no estilo das páginas de produto da Apple.
interface Props {
  title: string;
  /** Versão curta do título (ex.: "GED"), usada quando a tela não comporta o nome completo. */
  shortTitle?: string;
  links: { label: string; href: string }[];
  cta: { label: string; href: string };
}

const { title, shortTitle, links, cta } = Astro.props;
---

<nav class="subnav" aria-label={`Seções de ${title}`} data-subnav>
  <div class="subnav__bar">
    <a class="subnav__title" href="#conteudo" aria-label={shortTitle ? title : undefined}>
      {shortTitle ? (
        <>
          <span class="subnav__title-full">{title}</span>
          <span class="subnav__title-short">{shortTitle}</span>
        </>
      ) : (
        title
      )}
    </a>
    <ul class="subnav__links">
      {links.map((l) => (
        <li><a href={l.href}>{l.label}</a></li>
      ))}
    </ul>
    <a class="btn btn--sm subnav__cta" href={cta.href}>{cta.label}</a>
  </div>
</nav>

<script>
  // Destaca o link da seção visível.
  const nav = document.querySelector('[data-subnav]');
  const links = [...(nav?.querySelectorAll<HTMLAnchorElement>('.subnav__links a') ?? [])];
  const byId = new Map(links.map((a) => [a.hash.slice(1), a]));
  const spy = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((a) => a.removeAttribute('aria-current'));
        byId.get(entry.target.id)?.setAttribute('aria-current', 'true');
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  byId.forEach((_, id) => {
    const section = document.getElementById(id);
    if (section) spy.observe(section);
  });
</script>

<style>
  .subnav {
    --subnav-h: 56px;
    position: sticky;
    top: 0;
    z-index: 90;
  }

  .subnav::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(251 251 253 / 0.8);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    box-shadow: 0 1px 0 rgb(0 0 0 / 0.1);
  }

  /* Mesma estrutura do header principal: título na ponta esquerda (alinhado com a logo),
     links no centro exato e o botão na ponta direita (alinhado com o "Fale conosco"). */
  .subnav__bar {
    height: var(--subnav-h);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem;
    padding-inline: clamp(1rem, 3vw, 2.5rem);
  }

  .subnav__title {
    justify-self: start;
    max-width: 100%;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .subnav__title-short {
    display: none;
  }

  .subnav__links {
    display: flex;
    gap: clamp(1.5rem, 2.6vw, 2.75rem);
    list-style: none;
    padding: 0;
    font-size: 0.9375rem;
  }

  .subnav__links a {
    font-weight: 500;
    color: rgb(0 0 0 / 0.72);
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .subnav__links a:hover,
  .subnav__links a[aria-current] {
    color: var(--obp-blue);
  }

  .subnav__cta {
    justify-self: end;
    min-height: 36px;
    padding: 0.4375rem 1.125rem;
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  :global(html:has(.subnav)) {
    scroll-padding-top: 56px;
  }

  /* Telas médias: o nome completo não cabe ao lado dos links, então entra o título curto */
  @media (max-width: 1179px) {
    .subnav__title-full {
      display: none;
    }

    .subnav__title-short {
      display: inline;
    }
  }

  @media (max-width: 833px) {
    .subnav {
      --subnav-h: 52px;
    }

    .subnav__bar {
      display: flex;
      justify-content: space-between;
    }

    .subnav__links {
      display: none;
    }

    .subnav__title {
      font-size: 1.0625rem;
    }

    .subnav__cta {
      min-height: 32px;
      padding: 0.3125rem 0.875rem;
      font-size: 0.8125rem;
    }
  }
</style>
