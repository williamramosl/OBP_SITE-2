---
// Ilustração em HTML/CSS de um painel de monitoramento. Os números são ilustrativos.
const bars = [
  { label: 'Fin', value: 62 },
  { label: 'RH', value: 38 },
  { label: 'Com', value: 84 },
  { label: 'Ope', value: 100 },
  { label: 'TI', value: 27 },
  { label: 'Adm', value: 49 },
];
---

<div class="dash" aria-hidden="true">
  <div class="dash__head">
    <span>Impressões por setor</span>
    <span class="dash__pill">Este mês</span>
  </div>
  <div class="dash__bars">
    {bars.map((b, i) => (
      <div class="dash__bar" style={`--h: ${b.value}%; --i: ${i}`}>
        <span class="dash__fill"></span>
        <span class="dash__label">{b.label}</span>
      </div>
    ))}
  </div>
  <div class="dash__kpis">
    <div>
      <strong class="dash__kpi dash__kpi--good">−32%</strong>
      <span>custo por página</span>
    </div>
    <div>
      <strong class="dash__kpi">18,4 mil</strong>
      <span>páginas no mês</span>
    </div>
    <div>
      <strong class="dash__kpi">3</strong>
      <span>toners a repor</span>
    </div>
  </div>
</div>

<style>
  .dash {
    position: relative;
    z-index: 2;
    width: min(88%, 440px);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    padding: 1.25rem 1.25rem 1.125rem;
    border-radius: 20px;
    background: linear-gradient(160deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0.03));
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.12),
      0 30px 60px -20px rgb(0 0 0 / 0.6);
    text-align: left;
    font-size: 0.75rem;
    color: rgb(255 255 255 / 0.7);
  }

  .dash__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 600;
    color: var(--white);
    font-size: 0.8125rem;
  }

  .dash__pill {
    padding: 0.2rem 0.6rem;
    border-radius: 980px;
    background: rgb(255 255 255 / 0.1);
    font-weight: 500;
    font-size: 0.6875rem;
    color: rgb(255 255 255 / 0.75);
  }

  .dash__bars {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.625rem;
    height: 150px;
    margin-top: 1.25rem;
    padding-bottom: 1.25rem;
  }

  .dash__bar {
    position: relative;
    display: flex;
    align-items: flex-end;
  }

  .dash__fill {
    width: 100%;
    height: var(--h);
    border-radius: 6px;
    background: linear-gradient(180deg, var(--obp-blue-bright), var(--obp-blue));
    transform-origin: bottom;
  }

  .dash__bar:nth-child(4) .dash__fill {
    background: linear-gradient(180deg, #7cc0ff, var(--obp-blue-bright));
  }

  .dash__label {
    position: absolute;
    bottom: -1.25rem;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 0.6875rem;
  }

  .dash__kpis {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
  }

  .dash__kpis div {
    display: grid;
    gap: 0.125rem;
  }

  .dash__kpi {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--white);
  }

  .dash__kpi--good {
    color: #5ee6a4;
  }

  @media (prefers-reduced-motion: no-preference) {
    .dash__fill {
      transform: scaleY(0.05);
      transition: transform 1.1s var(--ease-out);
      transition-delay: calc(0.25s + var(--i) * 0.07s);
    }

    :global(.is-visible) .dash__fill,
    :global(html:not(.js)) .dash__fill {
      transform: none;
    }
  }
</style>
