---
// Topo padrão das páginas internas: título grande centralizado, apoio e, opcionalmente, ações e mídia.
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  theme?: 'light' | 'mist' | 'dark';
  id?: string;
}

const { eyebrow, title, lead, theme = 'light', id } = Astro.props;
---

<section id={id} class:list={['phero', `phero--${theme}`, { 'on-dark': theme === 'dark' }]}>
  <div class="phero__copy container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="phero__title">{title}</h1>
    {lead && <p class="lead phero__lead">{lead}</p>}
    {Astro.slots.has('actions') && (
      <div class="actions phero__actions">
        <slot name="actions" />
      </div>
    )}
    <slot />
  </div>
  {Astro.slots.has('media') && (
    <div class="phero__media">
      <slot name="media" />
    </div>
  )}
</section>

<style>
  .phero {
    padding-block: clamp(4rem, 2.5rem + 6vw, 7.5rem) clamp(4rem, 2.5rem + 5vw, 6.5rem);
    text-align: center;
    overflow: hidden;
  }

  .phero--mist {
    background: var(--obp-mist);
  }

  .phero--dark {
    background:
      radial-gradient(70% 60% at 50% 0%, rgb(27 128 245 / 0.2), transparent 70%),
      var(--navy);
    color: var(--white);
  }

  .phero__copy {
    max-width: 900px;
  }

  .phero__title {
    margin-top: 0.5rem;
    font-size: var(--fs-hero);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .phero__lead {
    max-width: 720px;
    margin: 1.25rem auto 0;
  }

  .phero__actions {
    margin-top: 2rem;
  }

  .phero__media {
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  @media (prefers-reduced-motion: no-preference) {
    .phero__copy > * {
      animation: phero-rise 1s var(--ease-out) both;
    }

    .phero__copy > :nth-child(2) { animation-delay: 0.07s; }
    .phero__copy > :nth-child(3) { animation-delay: 0.14s; }
    .phero__copy > :nth-child(n + 4) { animation-delay: 0.21s; }

    .phero__media {
      animation: phero-rise 1.2s 0.25s var(--ease-out) both;
    }
  }

  @keyframes phero-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
</style>
