---
// Topo com foto em tela cheia e texto sobreposto (desktop). Em telas menores o texto vai para cima e a foto
// para baixo, como nas páginas da Apple.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  image: ImageMetadata;
  alt: string;
  /** Lado em que o texto fica no desktop — escolha o lado "vazio" da foto */
  side?: 'left' | 'right';
  position?: string;
  mobilePosition?: string;
  /** Cor de fundo do bloco de texto no mobile, próxima do tom da foto */
  tone?: string;
  /** Escurecimento do lado do texto (0 a 1) */
  shade?: number;
  /** Escurecimento da foto inteira, para fotos claras (0 a 1) */
  tint?: number;
}

const {
  eyebrow,
  title,
  lead,
  image,
  alt,
  side = 'right',
  position = '50% 50%',
  mobilePosition = position,
  tone = '#1d1f24',
  shade = 0.35,
  tint = 0,
} = Astro.props;

const vars = [
  `--hero-bg: ${tone}`,
  `--hero-pos: ${position}`,
  `--hero-pos-m: ${mobilePosition}`,
  `--hero-shade: ${shade}`,
  `--hero-tint: ${tint}`,
].join('; ');
---

<section class:list={['hero', `hero--${side}`]} style={vars} aria-labelledby="hero-title">
  <div class="hero__media">
    <Image
      src={image}
      alt={alt}
      widths={[640, 960, 1280, 1920, 2560]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero__img"
    />
  </div>

  <div class="hero__content container-wide">
    <div class="hero__copy">
      {eyebrow && <p class="hero__eyebrow">{eyebrow}</p>}
      <h1 id="hero-title" class="hero__title">{title}</h1>
      {lead && <p class="hero__lead">{lead}</p>}
      {Astro.slots.has('default') && (
        <div class="actions hero__actions">
          <slot />
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--hero-bg);
    color: var(--white);
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(var(--hero-dir), rgb(0 0 0 / 0) 35%, rgb(14 16 20 / var(--hero-shade)) 100%),
      rgb(10 22 51 / var(--hero-tint));
  }

  .hero--right {
    --hero-dir: 90deg;
  }

  .hero--left {
    --hero-dir: 270deg;
  }

  .hero :global(.hero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--hero-pos);
  }

  .hero__content {
    min-height: clamp(560px, calc(100svh - var(--nav-h)), 900px);
    display: flex;
    align-items: center;
    padding-block: 4rem;
  }

  .hero--right .hero__content {
    justify-content: flex-end;
  }

  .hero__copy {
    width: min(100%, 540px, 40vw);
  }

  .hero--right .hero__copy {
    margin-right: clamp(0rem, 4vw, 4rem);
  }

  .hero--left .hero__copy {
    margin-left: clamp(0rem, 4vw, 4rem);
  }

  .hero__eyebrow {
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.375rem);
    font-weight: 600;
    color: #9cc8ff;
    margin-bottom: 0.75rem;
  }

  .hero__title {
    /* No layout sobreposto a largura do texto é limitada pela foto */
    font-size: min(4.75rem, 5.6vw);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .hero__lead {
    margin-top: 1.25rem;
    font-size: var(--fs-lead);
    line-height: 1.38;
    color: rgb(255 255 255 / 0.86);
    text-wrap: pretty;
  }

  .hero__actions {
    justify-content: flex-start;
    margin-top: 2rem;
  }

  .hero__actions :global(.link) {
    color: #cfe4ff;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero :global(.hero__img) {
      animation: hero-zoom 2.4s var(--ease-out) both;
    }

    .hero__copy > * {
      animation: hero-rise 1.1s var(--ease-out) both;
    }

    .hero__copy > :nth-child(2) { animation-delay: 0.08s; }
    .hero__copy > :nth-child(3) { animation-delay: 0.16s; }
    .hero__copy > :nth-child(4) { animation-delay: 0.24s; }
  }

  @keyframes hero-zoom {
    from { transform: scale(1.08); }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  /* Tablet e mobile: texto em cima, foto embaixo */
  @media (max-width: 1179px) {
    .hero {
      display: flex;
      flex-direction: column;
      text-align: center;
    }

    .hero__media {
      position: relative;
      order: 2;
      aspect-ratio: 16 / 9;
    }

    .hero__media::after {
      background:
        linear-gradient(180deg, var(--hero-bg) 0%, rgb(0 0 0 / 0) 22%),
        rgb(10 22 51 / calc(var(--hero-tint) * 0.5));
    }

    .hero :global(.hero__img) {
      object-position: var(--hero-pos-m);
    }

    .hero__content {
      min-height: 0;
      justify-content: center !important;
      padding-block: 3.5rem 1.5rem;
    }

    .hero__copy {
      width: min(100%, 640px);
      margin-inline: 0 !important;
    }

    .hero__title {
      font-size: var(--fs-hero);
    }

    .hero__actions {
      justify-content: center;
    }
  }

  @media (max-width: 833px) {
    .hero__media {
      aspect-ratio: 4 / 3;
    }
  }
</style>
