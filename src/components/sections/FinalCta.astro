---
import { Image } from 'astro:assets';
import { ChevronRight } from '@lucide/astro';
import reuniaoImg from '../../assets/img/reuniao.jpeg';
import SocialIcon from '../SocialIcon.astro';
import { company } from '../../data/site';
---

<section class="cta on-dark" aria-labelledby="cta-title">
  <Image
    src={reuniaoImg}
    alt=""
    widths={[640, 960, 1280, 1920, 2400]}
    sizes="100vw"
    class="cta__img"
  />
  <div class="cta__content container" data-reveal>
    <h2 id="cta-title" class="headline cta__title">Vamos reduzir o custo de impressão da sua empresa?</h2>
    <p class="lead cta__lead">Converse com um consultor e receba um diagnóstico do seu parque de impressão.</p>
    <div class="actions cta__actions">
      <a class="btn btn--light" href={company.whatsappHref} target="_blank" rel="noopener">
        <SocialIcon name="whatsapp" size={18} /> Falar no WhatsApp
      </a>
      <a class="link" href="/contato/">Enviar uma mensagem <ChevronRight aria-hidden="true" /></a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: var(--white);
    text-align: center;
    background: var(--navy);
  }

  .cta :global(.cta__img) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }

  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(10 22 51 / 0.72), rgb(10 22 51 / 0.88)),
      linear-gradient(90deg, rgb(8 53 155 / 0.35), transparent);
  }

  .cta__content {
    max-width: 820px;
    padding-block: clamp(6rem, 4rem + 10vw, 11rem);
  }

  .cta__lead {
    margin-top: 1.25rem;
    color: rgb(255 255 255 / 0.8);
  }

  .cta__actions {
    margin-top: 2.25rem;
  }
</style>
