---
import { Image } from 'astro:assets';
import { Activity, Layers, Rocket, ScanSearch } from '@lucide/astro';
import consultoriaImg from '../../assets/img/consultoria.jpeg';

const steps = [
  { icon: ScanSearch, title: 'Diagnóstico', text: 'Mapeamos equipamentos, volumes e custos atuais da sua operação.' },
  { icon: Layers, title: 'Projeto sob medida', text: 'Dimensionamos parque e contrato para a realidade da sua empresa.' },
  { icon: Rocket, title: 'Implantação', text: 'Instalamos, configuramos e treinamos sua equipe sem parar a operação.' },
  { icon: Activity, title: 'Monitoramento', text: 'Acompanhamos consumo, suprimentos e chamados de forma contínua.' },
];
---

<section class="section how" aria-labelledby="how-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="eyebrow">Como funciona</p>
      <h2 id="how-title" class="headline">Do diagnóstico ao controle total. Em quatro passos.</h2>
      <p class="lead">
        Um projeto feito sob medida para que você dedique seu tempo ao que importa: o seu negócio.
      </p>
    </header>
  </div>

  <div class="how__media container" data-reveal>
    <Image
      src={consultoriaImg}
      alt="Dois profissionais analisando informações em um notebook"
      widths={[640, 960, 1280, 1920]}
      sizes="(max-width: 1128px) 100vw, 1080px"
      class="how__img"
    />
  </div>

  <div class="container">
    <ol class="how__steps">
      {steps.map((step, i) => (
        <li class="how__step" data-reveal style={`--reveal-delay: ${i * 0.08}s`}>
          <span class="how__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <step.icon class="how__icon" aria-hidden="true" stroke-width={1.5} />
          <h3 class="how__title">{step.title}</h3>
          <p class="how__text">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .how__media {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 2 / 1;
  }

  .how :global(.how__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }

  .how__steps {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    margin-top: clamp(3rem, 5vw, 4.5rem);
    counter-reset: step;
  }

  .how__step {
    position: relative;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .how__num {
    position: absolute;
    top: 1.5rem;
    right: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .how :global(.how__icon) {
    width: 32px;
    height: 32px;
    color: var(--obp-blue);
  }

  .how__title {
    margin-top: 1rem;
    font-size: 1.3125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .how__text {
    margin-top: 0.375rem;
    color: var(--ink-2);
  }

  @media (max-width: 833px) {
    .how__media {
      aspect-ratio: 4 / 3;
      border-radius: var(--radius-md);
    }

    .how__steps {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .how__steps {
      grid-template-columns: 1fr;
    }
  }
</style>
