---
// Grade de blocos arredondados com título, texto, botões e um visual embaixo (foto, painel ou ícone).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Printer } from '@lucide/astro';
import PrintDashboard from '../PrintDashboard.astro';

export type TileAction = { label: string; href: string; srLabel?: string; external?: boolean };

export type Tile = {
  title: string;
  text: string;
  theme: 'light' | 'dark' | 'deep';
  image?: { src: ImageMetadata; alt: string; position?: string };
  dashboard?: boolean;
  icon?: typeof Printer;
  primary?: TileAction;
  secondary?: TileAction;
};

interface Props {
  tiles: Tile[];
  columns?: 2 | 3;
  /** Blocos mais baixos, para visuais de ícone */
  compact?: boolean;
  label?: string;
}

const { tiles, columns = 2, compact = false, label } = Astro.props;
const ext = (a: TileAction) => (a.external ? { target: '_blank', rel: 'noopener' } : {});
---

<section class="tiles" aria-label={label}>
  <div class:list={['tiles__grid', 'container-wide', `tiles__grid--${columns}`]}>
    {tiles.map((t, i) => (
      <article
        class:list={['tile', `tile--${t.theme}`, { 'tile--compact': compact }]}
        data-reveal
        style={`--reveal-delay: ${(i % columns) * 0.08}s`}
      >
        <div class="tile__copy">
          <h2 class="tile__title">{t.title}</h2>
          <p class="tile__text">{t.text}</p>
          {(t.primary || t.secondary) && (
            <div class="actions tile__actions">
              {t.primary && (
                <a class:list={['btn', 'btn--sm', { 'btn--light': t.theme !== 'light' }]} href={t.primary.href} {...ext(t.primary)}>
                  {t.primary.label}
                  {t.primary.srLabel && <span class="visually-hidden"> {t.primary.srLabel}</span>}
                </a>
              )}
              {t.secondary && (
                <a class="btn btn--sm btn--outline" href={t.secondary.href} {...ext(t.secondary)}>
                  {t.secondary.label}
                  {t.secondary.srLabel && <span class="visually-hidden"> {t.secondary.srLabel}</span>}
                </a>
              )}
            </div>
          )}
        </div>
        <div class="tile__visual">
          {t.image && (
            <Image
              src={t.image.src}
              alt={t.image.alt}
              widths={[480, 720, 960, 1280]}
              sizes={columns === 3 ? '(max-width: 833px) 100vw, 33vw' : '(max-width: 833px) 100vw, 50vw'}
              class="tile__img"
              style={`object-position: ${t.image.position ?? '50% 50%'}`}
            />
          )}
          {t.dashboard && <PrintDashboard />}
          {t.icon && (
            <span class="tile__glyph">
              <t.icon aria-hidden="true" stroke-width={1.25} />
            </span>
          )}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .tiles {
    padding-block: 12px;
  }

  .tiles__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .tiles__grid--3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: clamp(520px, 44vw, 640px);
    border-radius: var(--radius-md);
    overflow: hidden;
    text-align: center;
  }

  .tiles__grid--3 .tile {
    min-height: clamp(440px, 34vw, 540px);
  }

  .tile--compact,
  .tiles__grid--3 .tile--compact {
    min-height: clamp(380px, 30vw, 460px);
  }

  .tile--light {
    background: var(--obp-mist);
    color: var(--ink);
    --tile-bg: var(--obp-mist);
  }

  .tile--dark {
    background: var(--navy);
    color: var(--white);
    --tile-bg: var(--navy);
  }

  .tile--deep {
    background: #05080f;
    color: var(--white);
    --tile-bg: #05080f;
  }

  .tile__copy {
    position: relative;
    z-index: 1;
    padding: clamp(2.5rem, 4vw, 3.25rem) 1.5rem 1.5rem;
  }

  .tile__title {
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .tiles__grid--3 .tile__title {
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
  }

  .tile__text {
    max-width: 34ch;
    margin: 0.5rem auto 0;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.3125rem);
    line-height: 1.38;
    opacity: 0.82;
    text-wrap: pretty;
  }

  .tile__actions {
    margin-top: 1.25rem;
    gap: 0.75rem;
  }

  .tile--dark .btn--outline,
  .tile--deep .btn--outline {
    color: var(--white);
  }

  .tile--dark .btn--outline:hover,
  .tile--deep .btn--outline:hover {
    background: var(--white);
    color: var(--obp-blue);
  }

  .tile__visual {
    position: relative;
    flex: 1;
    min-height: 200px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  /* Funde a borda de cima da foto com o fundo do bloco */
  .tile__visual:has(.tile__img)::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 35%;
    z-index: 1;
    background: linear-gradient(var(--tile-bg), transparent);
    pointer-events: none;
  }

  .tile :global(.tile__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }

  .tile:hover :global(.tile__img) {
    transform: scale(1.03);
  }

  .tile__glyph {
    align-self: center;
    display: grid;
    place-items: center;
    width: clamp(96px, 10vw, 128px);
    aspect-ratio: 1;
    margin-bottom: 1rem;
    border-radius: 32px;
    color: var(--obp-blue);
    background: var(--white);
    box-shadow: 0 24px 48px -28px rgb(8 53 155 / 0.45);
    transition: transform 0.6s var(--ease-out);
  }

  .tile--dark .tile__glyph,
  .tile--deep .tile__glyph {
    color: var(--white);
    background: linear-gradient(160deg, var(--obp-blue-bright), var(--obp-blue));
    box-shadow: 0 24px 60px -24px rgb(27 128 245 / 0.6);
  }

  .tile__glyph :global(svg) {
    width: 50%;
    height: 50%;
  }

  .tile:hover .tile__glyph {
    transform: translateY(-4px) scale(1.03);
  }

  @media (max-width: 1023px) {
    .tiles__grid--3 {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 833px) {
    .tiles__grid {
      grid-template-columns: 1fr;
    }

    .tile {
      min-height: 500px;
    }

    .tile--compact,
    .tiles__grid--3 .tile,
    .tiles__grid--3 .tile--compact {
      min-height: 0;
    }

    .tile--compact .tile__visual,
    .tiles__grid--3 .tile__visual:not(:has(.tile__img)) {
      min-height: 0;
      padding-block: 1rem 1.5rem;
    }

    .tiles__grid--3 .tile__visual:has(.tile__img) {
      min-height: 260px;
    }
  }
</style>
