---
import { Handshake, MousePointerClick, ShieldCheck } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import Logo from '../components/Logo.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Stats from '../components/sections/Stats.astro';
import Sectors from '../components/sections/Sectors.astro';
import Partners from '../components/sections/Partners.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import equipeImg from '../assets/img/consultoria.jpeg';

const chapters = [
  {
    title: 'Experiência de mercado',
    text: 'Nossa equipe soma mais de duas décadas no mercado corporativo, atendendo indústrias, hospitais, administradoras de condomínios, instituições de ensino e empresas de pequeno, médio e grande porte.',
  },
  {
    title: 'TI e impressão no mesmo lugar',
    text: 'Atuamos como integradora de serviços de TI e especialista em outsourcing de impressão. Nossas soluções aprimoram processos, elevam a produtividade e reduzem custos de forma significativa.',
  },
  {
    title: 'Lado a lado com os fabricantes',
    text: 'Trabalhamos com Brother, Canon, HP, Kyocera, Ricoh e Samsung para garantir equipamentos, peças e suprimentos de qualidade nas demandas de documentos da sua empresa.',
  },
];

const pillars = [
  {
    icon: ShieldCheck,
    title: 'Credibilidade',
    text: 'Mais de duas décadas de relacionamento sólido com empresas de todos os portes.',
  },
  {
    icon: MousePointerClick,
    title: 'Facilidade',
    text: 'Soluções simples de usar e um único ponto de contato para tudo o que envolve impressão.',
  },
  {
    icon: Handshake,
    title: 'Parceria',
    text: 'Relação próxima com os principais fabricantes do mundo e com cada um dos nossos clientes.',
  },
];
---

<Base
  title="Quem somos | Office Brasil Print"
  description="Há mais de duas décadas a Office Brasil Print ajuda indústrias, hospitais, condomínios, instituições de ensino e empresas de todos os portes a imprimir com mais eficiência e menos custo."
>
  <section class="about-hero on-dark" aria-labelledby="about-title">
    <div class="about-hero__inner container">
      <Logo variant="selo" class="about-hero__logo" />
      <p class="eyebrow">Quem somos</p>
      <h1 id="about-title" class="about-hero__title">
        Mais de duas décadas simplificando a impressão das empresas.
      </h1>
    </div>
  </section>

  <section class="section story" aria-labelledby="story-title">
    <div class="container">
      <header class="story__intro" data-reveal>
        <p class="eyebrow">Nossa história</p>
        <h2 id="story-title" class="story__statement">
          Impressão não deveria ser uma preocupação.{' '}
          <span>Por isso cuidamos de equipamentos, suprimentos e documentos, para que você cuide do seu negócio.</span>
        </h2>
      </header>

      <div class="story__grid">
        <figure class="story__media" data-reveal>
          <Image
            src={equipeImg}
            alt="Dois profissionais da equipe analisando informações em um notebook"
            widths={[480, 720, 960, 1200]}
            sizes="(max-width: 833px) 100vw, 480px"
            class="story__img"
          />
          <figcaption class="story__badge">
            <strong>20+</strong>
            <span>anos de experiência no mercado corporativo</span>
          </figcaption>
        </figure>

        <ol class="story__chapters">
          {chapters.map((c, i) => (
            <li class="story__chapter" data-reveal style={`--reveal-delay: ${i * 0.08}s`}>
              <span class="story__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{c.title}</h3>
              <p>{c.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section section--mist" aria-labelledby="pillars-title">
    <div class="container">
      <header class="section-head" data-reveal>
        <p class="eyebrow">Nossos pilares</p>
        <h2 id="pillars-title" class="headline">O que nos move desde o primeiro dia.</h2>
      </header>
      <div class="pillars">
        <FeatureGrid items={pillars} />
      </div>
    </div>
  </section>

  <Stats />
  <Sectors />
  <Partners />
  <FinalCta />
</Base>

<style>
  .about-hero {
    position: relative;
    overflow: hidden;
    color: var(--white);
    text-align: center;
    background:
      radial-gradient(60% 55% at 50% 38%, rgb(27 128 245 / 0.45), transparent 70%),
      radial-gradient(90% 80% at 50% 110%, rgb(8 53 155 / 0.9), transparent 70%),
      var(--navy);
  }

  .about-hero__inner {
    display: grid;
    justify-items: center;
    padding-block: clamp(5rem, 3rem + 8vw, 9rem);
  }

  .about-hero :global(.about-hero__logo) {
    width: clamp(160px, 22vw, 260px);
    height: auto;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    filter: drop-shadow(0 20px 50px rgb(27 128 245 / 0.45));
  }

  .about-hero__title {
    max-width: 22ch;
    margin-top: 0.75rem;
    font-size: var(--fs-hero);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  @media (prefers-reduced-motion: no-preference) {
    .about-hero :global(.about-hero__logo) {
      animation: about-logo 1.6s var(--ease-out) both;
    }

    .about-hero__inner > :not(:first-child) {
      animation: about-rise 1s 0.35s var(--ease-out) both;
    }
  }

  @keyframes about-logo {
    from {
      opacity: 0;
      transform: scale(0.88);
      filter: drop-shadow(0 0 0 rgb(27 128 245 / 0)) blur(8px);
    }
  }

  @keyframes about-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  .story__intro {
    max-width: 920px;
  }

  .story__statement {
    margin-top: 0.75rem;
    font-size: clamp(1.75rem, 1.15rem + 2.4vw, 3rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.028em;
    text-wrap: pretty;
  }

  .story__statement span {
    color: var(--ink-3);
  }

  .story__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: center;
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .story__media {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    isolation: isolate;
  }

  .story :global(.story__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 50%;
  }

  .story__badge {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    display: grid;
    gap: 0.25rem;
    max-width: calc(100% - 2rem);
    padding: 0.875rem 1.125rem;
    border-radius: 16px;
    background: rgb(255 255 255 / 0.8);
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    box-shadow: 0 10px 30px -12px rgb(0 0 0 / 0.35);
  }

  .story__badge strong {
    font-size: 2rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    background: var(--grad-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .story__badge span {
    max-width: 20ch;
    font-size: 0.8125rem;
    line-height: 1.3;
    color: var(--ink-2);
  }

  .story__chapters {
    list-style: none;
    padding: 0;
  }

  .story__chapter {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    column-gap: 1rem;
    padding-block: 1.75rem;
  }

  .story__chapter + .story__chapter {
    border-top: 1px solid var(--line);
  }

  .story__chapter:first-child {
    padding-top: 0;
  }

  .story__chapter:last-child {
    padding-bottom: 0;
  }

  .story__num {
    grid-row: span 2;
    padding-top: 0.3rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--obp-blue);
    font-variant-numeric: tabular-nums;
  }

  .story__chapter h3 {
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .story__chapter p {
    margin-top: 0.5rem;
    color: var(--ink-2);
  }

  .pillars {
    margin-top: clamp(3rem, 5vw, 4.5rem);
  }

  @media (max-width: 833px) {
    .story__grid {
      grid-template-columns: 1fr;
    }

    .story__media {
      aspect-ratio: 4 / 3;
      border-radius: var(--radius-md);
    }

    /* No celular a foto é baixa: o selo vai para o canto de cima, sobre o quadro, sem cobrir rostos */
    .story__badge {
      top: 0.75rem;
      bottom: auto;
      left: 0.75rem;
      padding: 0.625rem 0.875rem;
    }

    .story__badge strong {
      font-size: 1.5rem;
    }

    .story__badge span {
      font-size: 0.75rem;
    }
  }
</style>
