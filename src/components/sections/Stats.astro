---
// TODO: os dois últimos números são PROVISÓRIOS — substituir pelos dados reais da empresa.
const stats = [
  { value: 20, prefix: '', suffix: '+', label: 'anos de experiência no mercado corporativo' },
  { value: 6, prefix: '', suffix: '', label: 'fabricantes parceiros entre os líderes mundiais' },
  { value: 500, prefix: '', suffix: '+', label: 'equipamentos sob nossa gestão' },
  { value: 30, prefix: 'até ', suffix: '%', label: 'de redução no custo de impressão' },
];
---

<section class="section section--dark stats" aria-labelledby="stats-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="eyebrow">Office Brasil Print em números</p>
      <h2 id="stats-title" class="headline">Experiência que vira <span class="text-gradient">economia</span>.</h2>
    </header>

    <dl class="stats__grid">
      {stats.map((s, i) => (
        <div class="stats__item" data-reveal style={`--reveal-delay: ${i * 0.08}s`}>
          <dt class="stats__label">{s.label}</dt>
          <dd class="stats__value">
            {s.prefix && <span class="stats__affix">{s.prefix}</span>}
            <span data-count={s.value}>{s.value}</span>
            <span class="stats__affix">{s.suffix}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .stats {
    background:
      radial-gradient(60% 80% at 50% 0%, rgb(27 128 245 / 0.18), transparent 70%),
      var(--navy);
  }

  .stats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .stats__item {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.5rem;
    text-align: center;
  }

  .stats__value {
    font-size: clamp(3rem, 2rem + 3.5vw, 4.75rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    background: var(--grad-brand-dark);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .stats__affix {
    font-size: 0.6em;
    letter-spacing: -0.02em;
  }

  .stats__label {
    max-width: 22ch;
    margin-inline: auto;
    font-size: 1.0625rem;
    color: #a1a8bd;
  }

  @media (max-width: 833px) {
    .stats__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem 1rem;
    }
  }
</style>
