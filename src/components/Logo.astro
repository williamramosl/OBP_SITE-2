---
// Wordmark "OBP" vetorizado a partir do arquivo oficial da logo (PNG 1024px).
// 'color' usa o azul da logo; 'mono' herda a cor do texto (ex.: branco no Quem Somos, cinza no rodapé).
// 'selo' é a logo completa no quadrado azul, como no papel timbrado (redesenhada em vetor a partir da proposta comercial).
interface Props {
  variant?: 'color' | 'mono' | 'selo';
  class?: string;
  title?: string;
}
const { variant = 'color', class: className, title = 'Office Brasil Print' } = Astro.props;
const obp = 'M400 2.1C365.4 4 323.9 11.8 292 22.3C250.4 36.1 208.4 58.1 172.5 85C121.6 123.1 82.9 169.8 53.6 228.6C11.4 313.5 0.6 411.8 23.5 504.8C36.8 559 61.3 609.4 96.8 655.2C139.4 710.5 204.5 758.9 271.5 785.3C291.8 793.3 314.8 800.8 327.5 803.6C330.8 804.3 338.7 806 345 807.5C356.4 810.1 359 810.5 381 813.4C438 820.8 499.3 816.2 555 800.4C577.7 793.9 611.7 780.7 632 770.5C641.5 765.7 666.2 751.2 678.5 743.2C730.6 709.2 775.2 661.8 807 606.5C813.5 595.3 826.8 568.5 829.3 561.5C851.4 501.3 859 462.4 859 409C859 354.6 850.1 307.4 830.4 257.8C824.3 242.3 819.4 232 818.2 232C806.6 232 622.2 232 612.3 232C603.1 232 598 232.4 598 233C598 233.6 603.7 239.6 610.6 246.3C642.2 276.8 663.2 314.7 671.9 356.7C678.3 388.2 678.7 424.1 672.9 454C666.2 488.4 650.2 523.7 629.6 549C621.8 558.7 607.8 572.7 597 581.6C552.4 618.6 496.6 638 435 638C373.8 637.9 322.4 620.6 277.5 584.9C234 550.4 205.5 500.1 197.5 444C190.8 396.4 198.6 344.4 218.6 304.5C232 277.9 249.6 255.1 271.5 236.2C301.9 210.1 338.6 192 378.4 183.6C403.8 178.2 379.2 178.5 806 178.5L1202.5 178.5 1211.5 180.8C1238.8 187.7 1256.2 204.8 1263 231.5C1268.7 253.7 1261.6 279.3 1245.4 295.7C1239.7 301.3 1236.3 303.8 1228.9 307.4C1223.7 309.9 1215.9 312.9 1211.5 314.2L1203.5 316.5 1071.5 317L939.5 317.5 939.2 320.4C939 322 939.6 326.9 940.4 331.4C948.7 373.4 949.2 423.6 941.9 471.1C940.6 479 939.6 487.3 939.6 489.5L939.5 493.5 1073 494L1206.5 494.5 1214.3 496.7C1226.3 500.1 1237.5 506.4 1245.1 514C1252.9 521.8 1256.8 528.3 1261.2 541C1264.2 549.9 1264.4 551.4 1264.5 564C1264.5 578.8 1262.8 586.5 1257 598C1248.3 615.2 1230.8 628.6 1209.8 634.2L1201.5 636.4 1042.6 636.7C926.2 637 883.3 637.4 882.3 638.2C881.5 638.8 879.1 642.5 876.8 646.4C872.3 654.3 860 671.9 850.1 685C834.8 705.1 809.9 731.4 788 750.6C767.8 768.4 732.3 794 712.7 805C709.5 806.8 707.1 808.7 707.3 809.4C707.6 810.2 773 810.6 958.1 810.8C1205.4 811.1 1219.5 810.9 1242.5 807.9C1324 797 1391 748.9 1425.7 676C1443 639.8 1451.2 594.4 1448.1 553.1C1446.6 534.5 1444 5